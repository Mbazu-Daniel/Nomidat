# Env for the web app only. Read by Vite from this directory (see envDir in
# vite.config.ts) — the repo root .env is for the API and is NOT loaded here.
#
# Copy to .env and edit. Only VITE_* reaches the browser.

# Where the browser finds the API.
# On a phone, "localhost" means the phone itself — for LAN testing (offline POS
# on a real device) change this to your machine's LAN address, e.g.
# http://192.168.1.129:3001, and start the app with `pnpm dev:lan`.
VITE_API_URL=http://localhost:3001

# The Telegram bot whose Login Widget renders on the auth pages.
# The bot's @username WITHOUT the @. Leave blank to hide the button.
# The signing token stays on the API and must never appear here.
VITE_TELEGRAM_BOT_USERNAME=