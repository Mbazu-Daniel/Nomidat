# Compiled output must never live in src/. These shadow the .ts source during
# module resolution, so a stale .js silently wins over edited TypeScript.
apps/*/src/**/*.js
apps/*/src/**/*.js.map
packages/*/src/**/*.js
packages/*/src/**/*.js.map
.claude
.github/skills 
agent*
.codex*
# The lint gate runs scripts/check-design-tokens.cjs, so that one ships; the
# migration pipeline beside it was one-off and stays on the machine that ran it.
scripts/*
!scripts/check-design-tokens.cjs
.github/hooks/ 