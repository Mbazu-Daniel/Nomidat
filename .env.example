POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nomidat-hack
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nomidat-hack
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
# Web (optional — defaults to http://localhost:3001)
VITE_API_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3001
# Google OAuth — authorized redirect URI:
#   http://localhost:3001/api/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ZeptoMail (optional — invitations log to console when unset)
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_URL=api.zeptomail.com/
ZEPTOMAIL_FROM_ADDRESS=
ZEPTOMAIL_FROM_NAME=Nomidat

# --- Payments ---
# Each business saves its own Paystack key through Settings.
# Required before saving a key: generate with `openssl rand -hex 32`.
# ENCRYPTION_KEY=your-64-character-hex-key
INVOICE_STORAGE_DIR=.data/invoices
PAYSTACK_API_URL=https://api.paystack.co
# Optional default redirect after Paystack checkout.
PAYSTACK_CALLBACK_URL=

# --- AI ---
# Select openai or gemini for chat. Picture extraction still requires OpenAI.
AI_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Speech: deepgram, whisper, or openai (OpenAI with optional Deepgram fallback).
TRANSCRIPTION_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1

# OpenAI is also used for picture extraction.
# Obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# --- Channels: native WhatsApp / Telegram photos, text and voice ---
# Both need a public HTTPS API URL forwarding to your API_PORT.
# Telegram webhook: /api/v1/channels/telegram/webhook
# WhatsApp webhook: /api/v1/channels/whatsapp/webhook (subscribe to messages)
# Link your account using Connected channels before testing.
# Send a photo captioned expense, sale, invoice or inventory; confirm in chat.
# Telegram — BotFather → /newbot → HTTP API token
# Also required for Mini App auth (POST /api/v1/auth/sign-in/telegram)
TELEGRAM_BOT_TOKEN=
# Required for Telegram webhooks; requests are rejected when this is unset.
# Generate with `openssl rand -hex 32`; pass the same value as setWebhook secret_token.
TELEGRAM_WEBHOOK_SECRET=
# WhatsApp Cloud API — Meta Developer App → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Generate with `openssl rand -hex 32`; must match Meta webhook "Verify token"
WHATSAPP_VERIFY_TOKEN=
# Required for WhatsApp webhook signature verification; unset rejects requests.
# Use the App secret from App settings → Basic.
WHATSAPP_APP_SECRET=
# Approved template for payment notifications outside the 24-hour session window.
WHATSAPP_TEMPLATE_NAME=

# Optional AI fallbacks
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Phone sign-in SMS (Termii dashboard credentials; never commit real keys)
TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_SENDER_ID=
