POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nomidat-hack
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nomidat-hack
API_PORT=3001
# Every origin the browser may call this API from. A browser treats localhost,
# 127.0.0.1 and a LAN address as three different origins, so list all of them you
# actually use — a missing one fails with a bare "Failed to fetch".
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3001
# Google OAuth â€” authorized redirect URI:
#   http://localhost:3001/api/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ZeptoMail (optional â€” invitations log to console when unset)
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_URL=api.zeptomail.com/
ZEPTOMAIL_FROM_ADDRESS=
ZEPTOMAIL_FROM_NAME=Nomidat

# --- Payments ---
# Each business saves its own Paystack key through Settings.
# ENCRYPTION_KEY is required once PLATFORM_PAYSTACK_SECRET is set: it is what
# encrypts those saved keys. Generate with `openssl rand -hex 32`, and back it up
# — rotating it makes every stored credential undecryptable.
# ENCRYPTION_KEY=your-64-character-hex-key
INVOICE_STORAGE_DIR=.data/invoices
PAYSTACK_API_URL=https://api.paystack.co
# Optional default redirect after Paystack checkout.
PAYSTACK_CALLBACK_URL=

# --- Platform ---
# One Paystack account for the whole platform; tenants never hold their own key.
# With this unset the platform collects nothing and payouts are refused outright.
# PLATFORM_PAYSTACK_SECRET=sk_test_xxx
# PLATFORM_PAYSTACK_PUBLIC=pk_test_xxx
# Default platform cut in basis points before a tenant has a negotiated rate.
# 1000 = 10%. 750 = 7.5%. Capped below 10_000 so a tenant is never left nothing.
PLATFORM_DEFAULT_FEE_BPS=0
# Comma-separated emails allowed to see cross-tenant platform data. An allow-list
# of identities rather than a role, because a platform admin can act on any tenant.
# PLATFORM_ADMIN_EMAILS=ops@example.com

# --- AI ---
# Select openai or gemini for chat. Picture extraction still requires OpenAI.
AI_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Speech: deepgram, whisper, or openai (OpenAI with optional Deepgram fallback).
TRANSCRIPTION_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1

# OpenAI is also used for picture extraction.
# Obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# --- Channels: native WhatsApp / Telegram photos, text and voice ---
# Both need a public HTTPS API URL forwarding to your API_PORT.
# Telegram webhook: /api/v1/channels/telegram/webhook
# WhatsApp webhook: /api/v1/channels/whatsapp/webhook (subscribe to messages)
# Link your account using Connected channels before testing.
# Send a photo captioned expense, sale, invoice or inventory; confirm in chat.
# Telegram â€” BotFather â†’ /newbot â†’ HTTP API token
# Also required for Telegram sign-in: the Login Widget on /login and /onboarding,
# plus Mini App auth (POST /api/v1/auth/sign-in/telegram-mini-app)
# The bot's @username WITHOUT the @. Reaches the browser, so the widget knows
# which button to render; the token above stays server-side and is never exposed.
TELEGRAM_BOT_TOKEN=
# Required for Telegram webhooks; requests are rejected when this is unset.
# Generate with `openssl rand -hex 32`; pass the same value as setWebhook secret_token.
TELEGRAM_WEBHOOK_SECRET=
# WhatsApp Cloud API â€” Meta Developer App â†’ WhatsApp â†’ API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Generate with `openssl rand -hex 32`; must match Meta webhook "Verify token"
WHATSAPP_VERIFY_TOKEN=
# Required for WhatsApp webhook signature verification; unset rejects requests.
# Use the App secret from App settings â†’ Basic.
WHATSAPP_APP_SECRET=
# Approved template for payment notifications outside the 24-hour session window.
WHATSAPP_TEMPLATE_NAME=

# Optional AI fallbacks
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Phone sign-in SMS (Termii dashboard credentials; never commit real keys)
TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_SENDER_ID=
