POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nomidat-hack
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nomidat-hack
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
# Web (optional — defaults to http://localhost:3001)
VITE_API_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3001
# Google OAuth — authorized redirect URI:
#   http://localhost:3001/api/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ZeptoMail (optional — invitations log to console when unset)
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_URL=api.zeptomail.com/
ZEPTOMAIL_FROM_ADDRESS=
ZEPTOMAIL_FROM_NAME=Nomidat
# Telegram bot (optional until channels are used)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# WhatsApp Cloud API (optional until channels are used)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_NAME=
