POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nomidat-hack
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nomidat-hack
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
# Web (optional — defaults to http://localhost:3001)
VITE_API_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3001
# Google OAuth — authorized redirect URI:
#   http://localhost:3001/api/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ZeptoMail (optional — invitations log to console when unset)
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_URL=api.zeptomail.com/
ZEPTOMAIL_FROM_ADDRESS=
ZEPTOMAIL_FROM_NAME=Nomidat

# --- Payments ---
# Paystack test key for local development; use the live secret key in production.
PAYSTACK_SECRET_KEY=
# Optional default redirect after Paystack checkout.
PAYSTACK_CALLBACK_URL=

# --- AI ---
# OpenAI API key for text understanding and voice transcription
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# --- Channels (see docs/channels.md for full setup + how to test) ---
# Telegram — BotFather → /newbot → HTTP API token
# Also required for Mini App auth (POST /api/v1/auth/sign-in/telegram)
TELEGRAM_BOT_TOKEN=
# Optional for local: leave empty to skip X-Telegram-Bot-Api-Secret-Token checks.
# Set before public deploy; pass the same value as setWebhook secret_token.
TELEGRAM_WEBHOOK_SECRET=
# WhatsApp Cloud API — Meta Developer App → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you invent; must match Meta webhook "Verify token"
WHATSAPP_VERIFY_TOKEN=
# Optional for local: leave empty to skip X-Hub-Signature-256 checks.
# Set to App secret (App settings → Basic) before public deploy.
WHATSAPP_APP_SECRET=
# Optional template name for out-of-24h-window sends (once wired)
WHATSAPP_TEMPLATE_NAME=
