#!/usr/bin/env sh

MAX_FILES=50
MAX_LINES=300
BRANCH="$(git rev-parse --abbrev-ref HEAD)"
BRANCH_PATTERN='^(feat|fix|refactor|chore|docs|test|ci|build|perf|style|hotfix)/[a-z0-9][a-z0-9/-]*$'

# Protected branches skip the naming check
case "$BRANCH" in
  main|master|dev|HEAD) ;;
  *)
    if ! printf '%s\n' "$BRANCH" | grep -Eq "$BRANCH_PATTERN"; then
      echo "BLOCKED: invalid branch name: $BRANCH"
      echo ""
      echo "Expected: type/short-slug"
      echo "Examples: feat/better-auth-mount  fix/health-check  chore/husky-hooks"
      echo "Allowed types: feat fix refactor chore docs test ci build perf style hotfix"
      exit 1
    fi
    ;;
esac

STAGED_FILES="$(git diff --cached --name-only --diff-filter=d | wc -l | tr -d ' ')"

if [ "$STAGED_FILES" -gt "$MAX_FILES" ]; then
  echo "BLOCKED: $STAGED_FILES files staged (max: $MAX_FILES)"
  echo ""
  echo "Split into smaller commits. Each commit should be atomic."
  echo "Use 'git reset HEAD' to unstage, then commit in batches."
  exit 1
fi

# Enforce the limit only for new code. Existing files already above 300
# lines are grandfathered in, but a file at or below 300 cannot grow past it.
LINE_CHECK_FILES=""

while IFS= read -r FILE; do
  case "$FILE" in
    *.js|*.jsx|*.ts|*.tsx|*.mjs|*.cjs|*.mts|*.cts) ;;
    *) continue ;;
  esac

  if git cat-file -e "HEAD:$FILE" 2>/dev/null; then
    BASE_LINES="$(git show "HEAD:$FILE" | wc -l | tr -d ' ')"
    if [ "$BASE_LINES" -gt "$MAX_LINES" ]; then
      continue
    fi
  fi

  CURRENT_LINES="$(wc -l < "$FILE" | tr -d ' ')"
  if [ "$CURRENT_LINES" -gt "$MAX_LINES" ]; then
    echo "BLOCKED: $FILE is $CURRENT_LINES lines (max: $MAX_LINES)"
    echo ""
    echo "Keep new or newly-expanded code files at 300 lines or fewer."
    echo "Existing files already above 300 lines are grandfathered in."
    exit 1
  fi

  LINE_CHECK_FILES="$LINE_CHECK_FILES
$FILE"
done <<EOF
$(git diff --cached --name-only --diff-filter=ACMR)
EOF

if [ -n "$(printf '%s' "$LINE_CHECK_FILES" | tr -d '[:space:]')" ]; then
  printf '%s\n' "$LINE_CHECK_FILES" |
    sed '/^[[:space:]]*$/d' |
    xargs pnpm exec oxlint --deny eslint/max-lines --no-error-on-unmatched-pattern

  if [ "$?" -ne 0 ]; then
    echo ""
    echo "BLOCKED: Oxlint max-lines check failed."
    exit 1
  fi
fi
