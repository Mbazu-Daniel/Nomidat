{
  "name": "nomidat",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint . && node scripts/check-design-tokens.cjs",
    "design:check": "node scripts/check-design-tokens.cjs",
    "design:migrate": "node scripts/add-design-tokens.cjs && node scripts/migrate-design-tokens.cjs && node scripts/normalise-design-structure.cjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @nomidat/db db:generate",
    "db:migrate": "pnpm --filter @nomidat/db db:migrate",
    "db:seed": "pnpm --filter @nomidat/db db:seed",
    "db:studio": "pnpm --filter @nomidat/db db:studio",
    "db:check": "node packages/db/scripts/check-migration-coverage.mjs",
    "db:verify": "node packages/db/scripts/verify-migrations.mjs",
    "fallow:audit": "pnpm test --coverage && fallow audit --format human --quiet",
    "ci:local": "act -P ubuntu-latest=catthehacker/ubuntu:act-22.04 --pull=false --bind -v",
    "prepare": "husky",
    "test": "vitest run"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^5.0.1",
    "fallow": "3.27.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "reflect-metadata": "^0.2.2",
    "turbo": "^2.10.12",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.2"
}
